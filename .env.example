PORT=3000
SESSION_SECRET=cambia-este-secreto-en-produccion
NODE_ENV=development

# Claves para registrarse como profesor o administrador.
# EN PRODUCCIÓN: generalas con `npm run generar-claves`; con NODE_ENV=production el servidor no arranca con estos valores de ejemplo.
# TRUST_PROXY=1   # si la app está detrás de un proxy/hosting
# TRASLADO_MINUTOS=30   # margen mínimo entre una clase en el liceo y otra en la UTU
PROFE_CODE=PROFE-2026
ADMIN_CODE=ADMIN-2026

# Figma: token personal (Figma > Settings > Security > Personal access tokens, permiso "File content: read")
FIGMA_TOKEN=

# Asistente (opcional)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Backups (solo administrador): carpeta, copias automáticas a conservar y apagado del backup diario
# BACKUP_DIR=./backups
# BACKUP_MAX_AUTO=14
# BACKUP_AUTO=1

# Faltas para entrar a la lista negra
# LIMITE_FALTAS=30

# Contraseña de las cuentas de los profesores (por defecto PROFE-2026)
PROFE_PASSWORD_INICIAL=PROFE-2026
